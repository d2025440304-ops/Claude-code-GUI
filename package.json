{
  "name": "claude-code-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight desktop GUI for Claude Code CLI — macOS only",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"sleep 2 && electron .\"",
    "build": "tsc -p tsconfig.electron.json && rm -rf dist-electron/db/migrations && cp -R electron/db/migrations dist-electron/db/migrations && vite build",
    "start": "electron ."
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "lucide-react": "^0.263.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "electron": "^31.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  }
}
